# Server only. Never prefix these with NEXT_PUBLIC_. Do not commit .env.local.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Choose a nonempty private app code; there is no minimum length.
# Share it only with invited users. They enter it in the app, never your
# DeepSeek key. Blank values and REPLACE_ME leave extraction disabled.
APP_ACCESS_TOKEN=
# Optional exact origin, e.g. https://recipes.example.com (no trailing slash).
# Leave unset for dynamic preview URLs; same-origin checks still apply.
APP_ORIGIN=
# In Vercel, publish the @vercel/firewall rule "recipe-extraction":
# fixed window, 10 requests / 10 minutes, deny with HTTP 429.
# Preview: enable Protection Bypass for Automation and automatic system env vars.
# Vercel manages its own SDK bypass secret; do not create another token here.
# See docs/DEPLOYMENT.md. A missing or unavailable rule blocks extraction.
