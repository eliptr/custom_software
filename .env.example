# Server only. Never prefix these with NEXT_PUBLIC_. Do not commit .env.local.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Generate at least 32 random characters; enter this token in the app to extract.
APP_ACCESS_TOKEN=
# Optional exact origin, e.g. https://recipes.example.com (no trailing slash).
# Leave unset for dynamic preview URLs; same-origin checks still apply.
APP_ORIGIN=
# Required for extraction in production/Vercel. Only quota counters are stored.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
